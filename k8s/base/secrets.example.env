# Template for k8s/overlays/local/secrets.env (gitignored).
# Copy to that path and fill in real dev values. DO NOT commit real secrets.
#
# Mirrors the credentials used by docker-compose / .env, but only the
# keys consumed by manifests in k8s/base.

# ---- Application database (ticketdb) ----
POSTGRES_USER=ticketadmin
POSTGRES_PASSWORD=
POSTGRES_DB=ticketdb

# ---- Keycloak (DB tenant + admin user) ----
KEYCLOAK_DB_USERNAME=ticketadmin
KEYCLOAK_DB_PASSWORD=
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=

# ---- LDAP ----
LDAP_ADMIN_PASSWORD=
LDAP_CUSTOMER_PASSWORD=
LDAP_AGENT_PASSWORD=
LDAP_LEAD_PASSWORD=
LDAP_MANAGER_PASSWORD=
LDAP_ADMIN_USER_PASSWORD=
LDAP_ADMINMANAGER_PASSWORD=
LDAP_LEADMANAGER_PASSWORD=
LDAP_SUPERADMIN_PASSWORD=

# ---- Backend datasource (Spring Boot) ----
SPRING_DATASOURCE_USERNAME=ticketadmin
SPRING_DATASOURCE_PASSWORD=

# ---- KIE Server credentials + shared internal callback token ----
JBPM_KIE_SERVER_USERNAME=kieserver
JBPM_KIE_SERVER_PASSWORD=
JBPM_KIE_SERVER_CALLBACK_TOKEN=
# Must match JBPM_KIE_SERVER_CALLBACK_TOKEN (used by llm-service for backend internal calls)
TICKET_SERVICE_INTERNAL_TOKEN=

# ---- Keycloak Admin Client (backend service account) ----
KEYCLOAK_ADMIN_CLIENT_SECRET=

# ---- Redis ----
SPRING_DATA_REDIS_PASSWORD=

# ---- Groq (LLM service) ----
GROQ_API_KEY=
