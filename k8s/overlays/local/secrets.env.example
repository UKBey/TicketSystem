# Copy to k8s/overlays/local/secrets.env (gitignored) and fill in dev values.
# Canonical key list for the `app-secrets` Secret — keys consumed by manifests
# in k8s/base. Mirrors the credentials used by docker-compose / .env.
# Prod: the same key list goes into the plain Secret that gets sealed
# (see k8s/overlays/prod/kustomization.yaml).
#

POSTGRES_USER=ticketadmin
POSTGRES_PASSWORD=321654
POSTGRES_DB=ticketdb

KEYCLOAK_DB_USERNAME=ticketadmin
KEYCLOAK_DB_PASSWORD=321654
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=321654

LDAP_ADMIN_PASSWORD=321654
LDAP_CUSTOMER_PASSWORD=321654
LDAP_AGENT_PASSWORD=321654
LDAP_LEAD_PASSWORD=321654
LDAP_MANAGER_PASSWORD=321654
LDAP_ADMIN_USER_PASSWORD=321654
LDAP_ADMINMANAGER_PASSWORD=321654
LDAP_LEADMANAGER_PASSWORD=321654
LDAP_SUPERADMIN_PASSWORD=321654

SPRING_DATASOURCE_USERNAME=ticketadmin
SPRING_DATASOURCE_PASSWORD=321654

JBPM_KIE_SERVER_USERNAME=kieserver
JBPM_KIE_SERVER_PASSWORD=kieserver1!
JBPM_KIE_SERVER_CALLBACK_TOKEN=local-callback-secret
TICKET_SERVICE_INTERNAL_TOKEN=local-callback-secret

KEYCLOAK_ADMIN_CLIENT_SECRET=pick-any-strong-random-secret

