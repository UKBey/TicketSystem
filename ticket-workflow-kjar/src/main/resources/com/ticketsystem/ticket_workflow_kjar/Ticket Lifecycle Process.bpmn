    <bpmn2:scriptTask id="_D11C5CD8-85CE-43A9-9FF8-361F43A3D47C" name="SLA Breach Callback" scriptFormat="http://www.java.com/java">
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[SLA Breach Callback]]></drools:metaValue>
        </drools:metaData>
      </bpmn2:extensionElements>
      <bpmn2:incoming>_3FB24E7C-EA5D-4A83-8A21-8C38A0A578D2</bpmn2:incoming>
      <bpmn2:outgoing>_E47B86F8-2A32-4142-A8D3-2019641C59F4</bpmn2:outgoing>
      <bpmn2:script><![CDATA[try {
    String token = "";
    int ti = callbackUrl.indexOf("token=");
    if (ti >= 0) { token = callbackUrl.substring(ti + 6); }

    java.net.URL url = new java.net.URL(callbackUrl);
    java.net.HttpURLConnection con = (java.net.HttpURLConnection) url.openConnection();
    con.setRequestMethod("POST");
    con.setRequestProperty("Content-Type", "application/json");
    con.setRequestProperty("X-Internal-Token", token);
    con.setConnectTimeout(5000);
    con.setReadTimeout(5000);
    con.setDoOutput(true);

    long piId = kcontext.getProcessInstance().getId();
    String body = "{\"ticketId\": " + ticketId
        + ", \"eventType\": \"SLA_BREACHED\""
        + ", \"processInstanceId\": " + piId
        + ", \"additionalData\": \"Priority: " + priority + "\"}";

    java.io.OutputStream os = con.getOutputStream();
    os.write(body.getBytes("UTF-8"));
    os.flush();
    os.close();

    int code = con.getResponseCode();
    System.out.println("[TICKET-WORKFLOW] SLA callback gonderildi ticketId=" + ticketId + " HTTP=" + code);
    con.disconnect();
} catch (Exception e) {
    System.out.println("[TICKET-WORKFLOW] SLA callback HATA ticketId=" + ticketId + ": " + e.getMessage());
}
]]></bpmn2:script>
    </bpmn2:scriptTask>
