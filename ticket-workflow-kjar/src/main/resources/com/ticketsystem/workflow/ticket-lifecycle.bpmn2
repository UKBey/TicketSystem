<?xml version="1.0" encoding="UTF-8"?>
<bpmn2:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xmlns:bpmn2="http://www.omg.org/spec/BPMN/20100524/MODEL"
                   xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                   xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                   xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                   xmlns:drools="http://www.jboss.org/drools"
                   xmlns:tns="http://www.jboss.org/drools"
                   id="_Definitions" targetNamespace="http://www.jboss.org/drools"
                   expressionLanguage="http://www.mvel.org/2.0"
                   typeLanguage="http://www.java.com/javaTypes">

    <!--
        Ticket lifecycle süreci — iki paralel kol:

        1) STATE BRANCH (yeni): Ticket statüsünün authoritative kaynağı. Her statü
           explicit bir wait noktası (event-based gateway). Statü geçişleri yalnız
           ilgili kaynak statünün kabul ettiği `transition_<TARGET>` signal'i ile
           tetiklenir; süreçteki ulaşılabilirlik valid geçişlerin BPMN şemasıyla
           hard-kodlandığı anlamına gelir. CLOSED → terminate end → tüm süreç
           biter.

        2) SLA BRANCH: SLA timer'ını ve pause/resume sinyallerini yönetir. State
           branch'ten bağımsız çalışır; geriye dönük uyumluluk için
           `pause_sla` / `resume_sla` / `ticket_closed` sinyalleri korunur.

        Backend `transition_*` sinyalleri atarak süreçteki statüyü ilerletir; pause/
        resume sinyalleri varlığını korur ama state branch artık otoriter olduğu
        için statünün geçerlilik kontrolü Java tarafında yapılmasa bile BPMN
        invalid geçişleri kabul etmez (signal'i tutan kaynak state node yoksa).
    -->

  <!-- Süreç değişken tipleri -->
  <bpmn2:itemDefinition id="_ticketIdItem" structureRef="String"/>
  <bpmn2:itemDefinition id="_priorityItem" structureRef="String"/>
  <bpmn2:itemDefinition id="_customerIdItem" structureRef="String"/>
  <bpmn2:itemDefinition id="_assigneeIdItem" structureRef="String"/>
  <bpmn2:itemDefinition id="_statusItem" structureRef="String"/>
  <bpmn2:itemDefinition id="_callbackUrlItem" structureRef="String"/>
  <bpmn2:itemDefinition id="_slaDurationItem" structureRef="String"/>

  <!-- Sinyaller -->
  <!-- SLA branch sinyalleri (geriye dönük uyumluluk) -->
  <bpmn2:signal id="Signal_PauseSla" name="pause_sla"/>
  <bpmn2:signal id="Signal_ResumeSla" name="resume_sla"/>
  <bpmn2:signal id="Signal_TicketClosed" name="ticket_closed"/>

  <!-- State branch sinyalleri (her geçiş için ayrı signal; geçerlilik BPMN
       şemasında: signal'i tutan kaynak state node yoksa süreç ilerlemez) -->
  <bpmn2:signal id="Signal_TransitionNew" name="transition_NEW"/>
  <bpmn2:signal id="Signal_TransitionInProgress" name="transition_IN_PROGRESS"/>
  <bpmn2:signal id="Signal_TransitionWaitingForCustomer" name="transition_WAITING_FOR_CUSTOMER"/>
  <bpmn2:signal id="Signal_TransitionResolved" name="transition_RESOLVED"/>
  <bpmn2:signal id="Signal_TransitionClosed" name="transition_CLOSED"/>

  <bpmn2:process id="com.ticketsystem.workflow.ticket-lifecycle"
                 name="Ticket Lifecycle Process"
                 isExecutable="true"
                 tns:packageName="com.ticketsystem.workflow">

    <!-- Süreç değişkenleri -->
    <bpmn2:property id="ticketId" itemSubjectRef="_ticketIdItem"/>
    <bpmn2:property id="priority" itemSubjectRef="_priorityItem"/>
    <bpmn2:property id="customerId" itemSubjectRef="_customerIdItem"/>
    <bpmn2:property id="assigneeId" itemSubjectRef="_assigneeIdItem"/>
    <bpmn2:property id="status" itemSubjectRef="_statusItem"/>
    <bpmn2:property id="callbackUrl" itemSubjectRef="_callbackUrlItem"/>
    <bpmn2:property id="slaDuration" itemSubjectRef="_slaDurationItem"/>

    <!-- ================================================================
         BAŞLANGIÇ + PARALLEL SPLIT
         ================================================================ -->

    <bpmn2:startEvent id="StartEvent_1" name="Ticket Created">
      <bpmn2:outgoing>Flow_Start_To_Init</bpmn2:outgoing>
    </bpmn2:startEvent>

    <bpmn2:scriptTask id="ScriptTask_Init" name="Log Ticket Init" scriptFormat="http://www.java.com/java">
      <bpmn2:incoming>Flow_Start_To_Init</bpmn2:incoming>
      <bpmn2:outgoing>Flow_Init_To_ParallelSplit</bpmn2:outgoing>
      <bpmn2:script>
        System.out.println("[TICKET-WORKFLOW] Süreç başlatıldı - TicketId: " + ticketId + ", Priority: " + priority + ", SLA: " + slaDuration);
      </bpmn2:script>
    </bpmn2:scriptTask>

    <!-- State ve SLA branch'lerini paralel başlatır. -->
    <bpmn2:parallelGateway id="Gateway_ParallelSplit" name="Split" gatewayDirection="Diverging">
      <bpmn2:incoming>Flow_Init_To_ParallelSplit</bpmn2:incoming>
      <bpmn2:outgoing>Flow_Split_To_StateNew</bpmn2:outgoing>
      <bpmn2:outgoing>Flow_Split_To_SlaMerge</bpmn2:outgoing>
    </bpmn2:parallelGateway>

    <!-- ================================================================
         STATE BRANCH — ticket statüsü için authoritative state machine
         ================================================================ -->

    <!-- STATE: NEW — yalnızca IN_PROGRESS'e geçilebilir. -->
    <bpmn2:eventBasedGateway id="State_NEW" name="State: NEW" gatewayDirection="Diverging">
      <bpmn2:incoming>Flow_Split_To_StateNew</bpmn2:incoming>
      <bpmn2:incoming>Flow_LogToNew_To_StateNew</bpmn2:incoming>
      <bpmn2:outgoing>Flow_StateNew_To_TransIP</bpmn2:outgoing>
      <bpmn2:outgoing>Flow_StateNew_To_TransClosed</bpmn2:outgoing>
    </bpmn2:eventBasedGateway>

    <bpmn2:intermediateCatchEvent id="StateNew_CatchInProgress" name="-&gt;IN_PROGRESS">
      <bpmn2:incoming>Flow_StateNew_To_TransIP</bpmn2:incoming>
      <bpmn2:outgoing>Flow_NewTransIP_To_LogIP</bpmn2:outgoing>
      <bpmn2:signalEventDefinition signalRef="Signal_TransitionInProgress"/>
    </bpmn2:intermediateCatchEvent>

    <bpmn2:intermediateCatchEvent id="StateNew_CatchClosed" name="-&gt;CLOSED">
      <bpmn2:incoming>Flow_StateNew_To_TransClosed</bpmn2:incoming>
      <bpmn2:outgoing>Flow_NewTransClosed_To_End</bpmn2:outgoing>
      <bpmn2:signalEventDefinition signalRef="Signal_TransitionClosed"/>
    </bpmn2:intermediateCatchEvent>

    <!-- STATE: IN_PROGRESS — en çok geçişe sahip merkez statü. -->
    <bpmn2:scriptTask id="ScriptTask_LogToInProgress" name="Log -&gt; IN_PROGRESS" scriptFormat="http://www.java.com/java">
      <bpmn2:incoming>Flow_NewTransIP_To_LogIP</bpmn2:incoming>
      <bpmn2:incoming>Flow_WaitingTransIP_To_LogIP</bpmn2:incoming>
      <bpmn2:incoming>Flow_ResolvedTransIP_To_LogIP</bpmn2:incoming>
      <bpmn2:outgoing>Flow_LogIP_To_StateIP</bpmn2:outgoing>
      <bpmn2:script>
        kcontext.setVariable("status", "IN_PROGRESS");
        System.out.println("[TICKET-WORKFLOW] State -> IN_PROGRESS - TicketId: " + ticketId);
      </bpmn2:script>
    </bpmn2:scriptTask>

    <bpmn2:eventBasedGateway id="State_IN_PROGRESS" name="State: IN_PROGRESS" gatewayDirection="Diverging">
      <bpmn2:incoming>Flow_LogIP_To_StateIP</bpmn2:incoming>
      <bpmn2:outgoing>Flow_StateIP_To_TransNew</bpmn2:outgoing>
      <bpmn2:outgoing>Flow_StateIP_To_TransWaiting</bpmn2:outgoing>
      <bpmn2:outgoing>Flow_StateIP_To_TransResolved</bpmn2:outgoing>
      <bpmn2:outgoing>Flow_StateIP_To_TransClosed</bpmn2:outgoing>
    </bpmn2:eventBasedGateway>

    <bpmn2:intermediateCatchEvent id="StateIP_CatchNew" name="-&gt;NEW">
      <bpmn2:incoming>Flow_StateIP_To_TransNew</bpmn2:incoming>
      <bpmn2:outgoing>Flow_IPTransNew_To_LogNew</bpmn2:outgoing>
      <bpmn2:signalEventDefinition signalRef="Signal_TransitionNew"/>
    </bpmn2:intermediateCatchEvent>

    <bpmn2:intermediateCatchEvent id="StateIP_CatchWaiting" name="-&gt;WAITING">
      <bpmn2:incoming>Flow_StateIP_To_TransWaiting</bpmn2:incoming>
      <bpmn2:outgoing>Flow_IPTransWaiting_To_LogWaiting</bpmn2:outgoing>
      <bpmn2:signalEventDefinition signalRef="Signal_TransitionWaitingForCustomer"/>
    </bpmn2:intermediateCatchEvent>

    <bpmn2:intermediateCatchEvent id="StateIP_CatchResolved" name="-&gt;RESOLVED">
      <bpmn2:incoming>Flow_StateIP_To_TransResolved</bpmn2:incoming>
      <bpmn2:outgoing>Flow_IPTransResolved_To_LogResolved</bpmn2:outgoing>
      <bpmn2:signalEventDefinition signalRef="Signal_TransitionResolved"/>
    </bpmn2:intermediateCatchEvent>

    <bpmn2:intermediateCatchEvent id="StateIP_CatchClosed" name="-&gt;CLOSED">
      <bpmn2:incoming>Flow_StateIP_To_TransClosed</bpmn2:incoming>
      <bpmn2:outgoing>Flow_IPTransClosed_To_End</bpmn2:outgoing>
      <bpmn2:signalEventDefinition signalRef="Signal_TransitionClosed"/>
    </bpmn2:intermediateCatchEvent>

    <!-- Geçiş log script'leri (her geçiş status değişkenini günceller) -->
    <bpmn2:scriptTask id="ScriptTask_LogToNew" name="Log -&gt; NEW" scriptFormat="http://www.java.com/java">
      <bpmn2:incoming>Flow_IPTransNew_To_LogNew</bpmn2:incoming>
      <bpmn2:outgoing>Flow_LogToNew_To_StateNew</bpmn2:outgoing>
      <bpmn2:script>
        kcontext.setVariable("status", "NEW");
        System.out.println("[TICKET-WORKFLOW] State -> NEW (unclaim) - TicketId: " + ticketId);
      </bpmn2:script>
    </bpmn2:scriptTask>

    <bpmn2:scriptTask id="ScriptTask_LogToWaiting" name="Log -&gt; WAITING" scriptFormat="http://www.java.com/java">
      <bpmn2:incoming>Flow_IPTransWaiting_To_LogWaiting</bpmn2:incoming>
      <bpmn2:outgoing>Flow_LogToWaiting_To_StateWaiting</bpmn2:outgoing>
      <bpmn2:script>
        kcontext.setVariable("status", "WAITING_FOR_CUSTOMER");
        System.out.println("[TICKET-WORKFLOW] State -> WAITING_FOR_CUSTOMER - TicketId: " + ticketId);
      </bpmn2:script>
    </bpmn2:scriptTask>

    <bpmn2:scriptTask id="ScriptTask_LogToResolved" name="Log -&gt; RESOLVED" scriptFormat="http://www.java.com/java">
      <bpmn2:incoming>Flow_IPTransResolved_To_LogResolved</bpmn2:incoming>
      <bpmn2:outgoing>Flow_LogToResolved_To_StateResolved</bpmn2:outgoing>
      <bpmn2:script>
        kcontext.setVariable("status", "RESOLVED");
        System.out.println("[TICKET-WORKFLOW] State -> RESOLVED - TicketId: " + ticketId);
      </bpmn2:script>
    </bpmn2:scriptTask>

    <!-- STATE: WAITING_FOR_CUSTOMER -->
    <bpmn2:eventBasedGateway id="State_WAITING" name="State: WAITING_FOR_CUSTOMER" gatewayDirection="Diverging">
      <bpmn2:incoming>Flow_LogToWaiting_To_StateWaiting</bpmn2:incoming>
      <bpmn2:outgoing>Flow_StateWaiting_To_TransIP</bpmn2:outgoing>
      <bpmn2:outgoing>Flow_StateWaiting_To_TransClosed</bpmn2:outgoing>
    </bpmn2:eventBasedGateway>

    <bpmn2:intermediateCatchEvent id="StateWaiting_CatchInProgress" name="-&gt;IN_PROGRESS">
      <bpmn2:incoming>Flow_StateWaiting_To_TransIP</bpmn2:incoming>
      <bpmn2:outgoing>Flow_WaitingTransIP_To_LogIP</bpmn2:outgoing>
      <bpmn2:signalEventDefinition signalRef="Signal_TransitionInProgress"/>
    </bpmn2:intermediateCatchEvent>

    <bpmn2:intermediateCatchEvent id="StateWaiting_CatchClosed" name="-&gt;CLOSED">
      <bpmn2:incoming>Flow_StateWaiting_To_TransClosed</bpmn2:incoming>
      <bpmn2:outgoing>Flow_WaitingTransClosed_To_End</bpmn2:outgoing>
      <bpmn2:signalEventDefinition signalRef="Signal_TransitionClosed"/>
    </bpmn2:intermediateCatchEvent>

    <!-- STATE: RESOLVED -->
    <bpmn2:eventBasedGateway id="State_RESOLVED" name="State: RESOLVED" gatewayDirection="Diverging">
      <bpmn2:incoming>Flow_LogToResolved_To_StateResolved</bpmn2:incoming>
      <bpmn2:outgoing>Flow_StateResolved_To_TransIP</bpmn2:outgoing>
      <bpmn2:outgoing>Flow_StateResolved_To_TransClosed</bpmn2:outgoing>
    </bpmn2:eventBasedGateway>

    <bpmn2:intermediateCatchEvent id="StateResolved_CatchInProgress" name="-&gt;IN_PROGRESS">
      <bpmn2:incoming>Flow_StateResolved_To_TransIP</bpmn2:incoming>
      <bpmn2:outgoing>Flow_ResolvedTransIP_To_LogIP</bpmn2:outgoing>
      <bpmn2:signalEventDefinition signalRef="Signal_TransitionInProgress"/>
    </bpmn2:intermediateCatchEvent>

    <bpmn2:intermediateCatchEvent id="StateResolved_CatchClosed" name="-&gt;CLOSED">
      <bpmn2:incoming>Flow_StateResolved_To_TransClosed</bpmn2:incoming>
      <bpmn2:outgoing>Flow_ResolvedTransClosed_To_End</bpmn2:outgoing>
      <bpmn2:signalEventDefinition signalRef="Signal_TransitionClosed"/>
    </bpmn2:intermediateCatchEvent>

    <!-- State branch TERMINATE END — tüm süreci (SLA branch dahil) sonlandırır. -->
    <bpmn2:scriptTask id="ScriptTask_LogClosed" name="Log -&gt; CLOSED" scriptFormat="http://www.java.com/java">
      <bpmn2:incoming>Flow_NewTransClosed_To_End</bpmn2:incoming>
      <bpmn2:incoming>Flow_IPTransClosed_To_End</bpmn2:incoming>
      <bpmn2:incoming>Flow_WaitingTransClosed_To_End</bpmn2:incoming>
      <bpmn2:incoming>Flow_ResolvedTransClosed_To_End</bpmn2:incoming>
      <bpmn2:outgoing>Flow_LogClosed_To_End</bpmn2:outgoing>
      <bpmn2:script>
        kcontext.setVariable("status", "CLOSED");
        System.out.println("[TICKET-WORKFLOW] State -> CLOSED - TicketId: " + ticketId);
      </bpmn2:script>
    </bpmn2:scriptTask>

    <bpmn2:endEvent id="EndEvent_StateClosed" name="Closed (terminate)">
      <bpmn2:incoming>Flow_LogClosed_To_End</bpmn2:incoming>
      <bpmn2:terminateEventDefinition/>
    </bpmn2:endEvent>

    <!-- ================================================================
         SLA BRANCH — mevcut SLA timer/pause/resume akışı korunur
         ================================================================ -->

    <!-- SLA dalına giriş; init ve resume kollarını birleştiren XOR. -->
    <bpmn2:exclusiveGateway id="Gateway_XorMerge" name="Merge Gateway" gatewayDirection="Converging">
      <bpmn2:incoming>Flow_Split_To_SlaMerge</bpmn2:incoming>
      <bpmn2:incoming>Flow_ResumeScript_To_XorMerge</bpmn2:incoming>
      <bpmn2:outgoing>Flow_XorMerge_To_SlaGateway</bpmn2:outgoing>
    </bpmn2:exclusiveGateway>

    <!-- SLA ana bekleme noktası: timer, pause_sla veya ticket_closed -->
    <bpmn2:eventBasedGateway id="Gateway_Sla" name="SLA Gateway" gatewayDirection="Diverging">
      <bpmn2:incoming>Flow_XorMerge_To_SlaGateway</bpmn2:incoming>
      <bpmn2:outgoing>Flow_SlaGw_To_Timer</bpmn2:outgoing>
      <bpmn2:outgoing>Flow_SlaGw_To_PauseSignal</bpmn2:outgoing>
      <bpmn2:outgoing>Flow_SlaGw_To_CloseSignal1</bpmn2:outgoing>
    </bpmn2:eventBasedGateway>

    <bpmn2:intermediateCatchEvent id="Timer_SlaDeadline" name="SLA Timer">
      <bpmn2:incoming>Flow_SlaGw_To_Timer</bpmn2:incoming>
      <bpmn2:outgoing>Flow_Timer_To_BreachLog</bpmn2:outgoing>
      <bpmn2:timerEventDefinition>
        <bpmn2:timeDuration xsi:type="bpmn2:tFormalExpression">#{slaDuration}</bpmn2:timeDuration>
      </bpmn2:timerEventDefinition>
    </bpmn2:intermediateCatchEvent>

    <bpmn2:intermediateCatchEvent id="Signal_PauseSla_Catch" name="Pause SLA Signal">
      <bpmn2:incoming>Flow_SlaGw_To_PauseSignal</bpmn2:incoming>
      <bpmn2:outgoing>Flow_PauseSignal_To_PauseLog</bpmn2:outgoing>
      <bpmn2:signalEventDefinition signalRef="Signal_PauseSla"/>
    </bpmn2:intermediateCatchEvent>

    <bpmn2:intermediateCatchEvent id="Signal_Close_InSla" name="Close (SLA Active)">
      <bpmn2:incoming>Flow_SlaGw_To_CloseSignal1</bpmn2:incoming>
      <bpmn2:outgoing>Flow_CloseInSla_To_CloseLog</bpmn2:outgoing>
      <bpmn2:signalEventDefinition signalRef="Signal_TicketClosed"/>
    </bpmn2:intermediateCatchEvent>

    <bpmn2:scriptTask id="ScriptTask_BreachLog" name="Log SLA Breach" scriptFormat="http://www.java.com/java">
      <bpmn2:incoming>Flow_Timer_To_BreachLog</bpmn2:incoming>
      <bpmn2:outgoing>Flow_BreachLog_To_RestCall</bpmn2:outgoing>
      <bpmn2:script>
        System.out.println("[TICKET-WORKFLOW] SLA AŞIMI! TicketId: " + ticketId + " - Süre doldu, callback gönderilecek.");
      </bpmn2:script>
    </bpmn2:scriptTask>

    <bpmn2:task id="RestTask_SlaCallback" name="SLA Breach Callback" drools:taskName="Rest">
      <bpmn2:incoming>Flow_BreachLog_To_RestCall</bpmn2:incoming>
      <bpmn2:outgoing>Flow_RestCall_To_PostBreachClose</bpmn2:outgoing>
      <bpmn2:ioSpecification>
        <bpmn2:dataInput id="RestTask_urlInput" drools:dtype="String" name="Url"/>
        <bpmn2:dataInput id="RestTask_methodInput" drools:dtype="String" name="Method"/>
        <bpmn2:dataInput id="RestTask_contentTypeInput" drools:dtype="String" name="ContentType"/>
        <bpmn2:dataInput id="RestTask_contentInput" drools:dtype="String" name="Content"/>
        <bpmn2:dataInput id="RestTask_TaskNameInput" drools:dtype="String" name="TaskName"/>
        <bpmn2:inputSet>
          <bpmn2:dataInputRefs>RestTask_urlInput</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>RestTask_methodInput</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>RestTask_contentTypeInput</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>RestTask_contentInput</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>RestTask_TaskNameInput</bpmn2:dataInputRefs>
        </bpmn2:inputSet>
        <bpmn2:outputSet/>
      </bpmn2:ioSpecification>
      <bpmn2:dataInputAssociation>
        <bpmn2:targetRef>RestTask_TaskNameInput</bpmn2:targetRef>
        <bpmn2:assignment>
          <bpmn2:from xsi:type="bpmn2:tFormalExpression"><![CDATA[Rest]]></bpmn2:from>
          <bpmn2:to xsi:type="bpmn2:tFormalExpression"><![CDATA[RestTask_TaskNameInput]]></bpmn2:to>
        </bpmn2:assignment>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation>
        <bpmn2:targetRef>RestTask_urlInput</bpmn2:targetRef>
        <bpmn2:assignment>
          <bpmn2:from xsi:type="bpmn2:tFormalExpression"><![CDATA[#{callbackUrl}]]></bpmn2:from>
          <bpmn2:to xsi:type="bpmn2:tFormalExpression"><![CDATA[RestTask_urlInput]]></bpmn2:to>
        </bpmn2:assignment>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation>
        <bpmn2:targetRef>RestTask_methodInput</bpmn2:targetRef>
        <bpmn2:assignment>
          <bpmn2:from xsi:type="bpmn2:tFormalExpression"><![CDATA[POST]]></bpmn2:from>
          <bpmn2:to xsi:type="bpmn2:tFormalExpression"><![CDATA[RestTask_methodInput]]></bpmn2:to>
        </bpmn2:assignment>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation>
        <bpmn2:targetRef>RestTask_contentTypeInput</bpmn2:targetRef>
        <bpmn2:assignment>
          <bpmn2:from xsi:type="bpmn2:tFormalExpression"><![CDATA[application/json]]></bpmn2:from>
          <bpmn2:to xsi:type="bpmn2:tFormalExpression"><![CDATA[RestTask_contentTypeInput]]></bpmn2:to>
        </bpmn2:assignment>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation>
        <bpmn2:targetRef>RestTask_contentInput</bpmn2:targetRef>
        <bpmn2:assignment>
          <bpmn2:from xsi:type="bpmn2:tFormalExpression"><![CDATA[{"ticketId": #{ticketId}, "eventType": "SLA_BREACHED", "processInstanceId": #{processInstanceId}, "additionalData": "Priority: #{priority}"}]]></bpmn2:from>
          <bpmn2:to xsi:type="bpmn2:tFormalExpression"><![CDATA[RestTask_contentInput]]></bpmn2:to>
        </bpmn2:assignment>
      </bpmn2:dataInputAssociation>
    </bpmn2:task>

    <!-- SLA breach sonrası close sinyali beklenir; bu kol state branch'in
         terminate end'i tetiklemesiyle de sona erebilir. -->
    <bpmn2:intermediateCatchEvent id="Signal_Close_PostBreach" name="Close (Post Breach)">
      <bpmn2:incoming>Flow_RestCall_To_PostBreachClose</bpmn2:incoming>
      <bpmn2:outgoing>Flow_ClosePostBreach_To_PostBreachCloseLog</bpmn2:outgoing>
      <bpmn2:signalEventDefinition signalRef="Signal_TicketClosed"/>
    </bpmn2:intermediateCatchEvent>

    <bpmn2:scriptTask id="ScriptTask_PostBreachClose" name="Log Close Post Breach" scriptFormat="http://www.java.com/java">
      <bpmn2:incoming>Flow_ClosePostBreach_To_PostBreachCloseLog</bpmn2:incoming>
      <bpmn2:outgoing>Flow_PostBreachClose_To_End3</bpmn2:outgoing>
      <bpmn2:script>
        System.out.println("[TICKET-WORKFLOW] SLA breach sonrası ticket kapatıldı. TicketId: " + ticketId);
      </bpmn2:script>
    </bpmn2:scriptTask>

    <!-- Pause yolu -->
    <bpmn2:scriptTask id="ScriptTask_PauseLog" name="Log SLA Paused" scriptFormat="http://www.java.com/java">
      <bpmn2:incoming>Flow_PauseSignal_To_PauseLog</bpmn2:incoming>
      <bpmn2:outgoing>Flow_PauseLog_To_PausedGw</bpmn2:outgoing>
      <bpmn2:script>
        System.out.println("[TICKET-WORKFLOW] SLA durduruldu. TicketId: " + ticketId);
      </bpmn2:script>
    </bpmn2:scriptTask>

    <bpmn2:eventBasedGateway id="Gateway_Paused" name="Paused Gateway" gatewayDirection="Diverging">
      <bpmn2:incoming>Flow_PauseLog_To_PausedGw</bpmn2:incoming>
      <bpmn2:outgoing>Flow_PausedGw_To_ResumeSignal</bpmn2:outgoing>
      <bpmn2:outgoing>Flow_PausedGw_To_CloseSignal2</bpmn2:outgoing>
    </bpmn2:eventBasedGateway>

    <bpmn2:intermediateCatchEvent id="Signal_ResumeSla_Catch" name="Resume SLA Signal">
      <bpmn2:incoming>Flow_PausedGw_To_ResumeSignal</bpmn2:incoming>
      <bpmn2:outgoing>Flow_ResumeSignal_To_ResumeLog</bpmn2:outgoing>
      <bpmn2:signalEventDefinition signalRef="Signal_ResumeSla"/>
    </bpmn2:intermediateCatchEvent>

    <bpmn2:intermediateCatchEvent id="Signal_Close_InPaused" name="Close (Paused)">
      <bpmn2:incoming>Flow_PausedGw_To_CloseSignal2</bpmn2:incoming>
      <bpmn2:outgoing>Flow_CloseInPaused_To_CloseLog</bpmn2:outgoing>
      <bpmn2:signalEventDefinition signalRef="Signal_TicketClosed"/>
    </bpmn2:intermediateCatchEvent>

    <bpmn2:scriptTask id="ScriptTask_ResumeLog" name="Log SLA Resumed" scriptFormat="http://www.java.com/java">
      <bpmn2:incoming>Flow_ResumeSignal_To_ResumeLog</bpmn2:incoming>
      <bpmn2:outgoing>Flow_ResumeScript_To_XorMerge</bpmn2:outgoing>
      <bpmn2:script>
        System.out.println("[TICKET-WORKFLOW] SLA devam ettiriliyor. TicketId: " + ticketId + ", Kalan SLA: " + slaDuration);
      </bpmn2:script>
    </bpmn2:scriptTask>

    <bpmn2:scriptTask id="ScriptTask_CloseInSlaLog" name="Log Close (SLA Active)" scriptFormat="http://www.java.com/java">
      <bpmn2:incoming>Flow_CloseInSla_To_CloseLog</bpmn2:incoming>
      <bpmn2:outgoing>Flow_CloseInSlaLog_To_End1</bpmn2:outgoing>
      <bpmn2:script>
        System.out.println("[TICKET-WORKFLOW] Ticket kapatildi (SLA aktifken). TicketId: " + ticketId);
      </bpmn2:script>
    </bpmn2:scriptTask>

    <bpmn2:scriptTask id="ScriptTask_CloseInPausedLog" name="Log Close (Paused)" scriptFormat="http://www.java.com/java">
      <bpmn2:incoming>Flow_CloseInPaused_To_CloseLog</bpmn2:incoming>
      <bpmn2:outgoing>Flow_CloseInPausedLog_To_End2</bpmn2:outgoing>
      <bpmn2:script>
        System.out.println("[TICKET-WORKFLOW] Ticket kapatildi (bekleme modundayken). TicketId: " + ticketId);
      </bpmn2:script>
    </bpmn2:scriptTask>

    <bpmn2:endEvent id="EndEvent_ClosedFromSla" name="SLA branch end (SLA active)">
      <bpmn2:incoming>Flow_CloseInSlaLog_To_End1</bpmn2:incoming>
    </bpmn2:endEvent>

    <bpmn2:endEvent id="EndEvent_ClosedFromPaused" name="SLA branch end (Paused)">
      <bpmn2:incoming>Flow_CloseInPausedLog_To_End2</bpmn2:incoming>
    </bpmn2:endEvent>

    <bpmn2:endEvent id="EndEvent_ClosedPostBreach" name="SLA branch end (Post Breach)">
      <bpmn2:incoming>Flow_PostBreachClose_To_End3</bpmn2:incoming>
    </bpmn2:endEvent>

    <!-- ================================================================
         SEQUENCE FLOWS
         ================================================================ -->

    <!-- Start → Init → Parallel split -->
    <bpmn2:sequenceFlow id="Flow_Start_To_Init" sourceRef="StartEvent_1" targetRef="ScriptTask_Init"/>
    <bpmn2:sequenceFlow id="Flow_Init_To_ParallelSplit" sourceRef="ScriptTask_Init" targetRef="Gateway_ParallelSplit"/>

    <!-- Split → State branch + SLA branch -->
    <bpmn2:sequenceFlow id="Flow_Split_To_StateNew" sourceRef="Gateway_ParallelSplit" targetRef="State_NEW"/>
    <bpmn2:sequenceFlow id="Flow_Split_To_SlaMerge" sourceRef="Gateway_ParallelSplit" targetRef="Gateway_XorMerge"/>

    <!-- STATE BRANCH: NEW -->
    <bpmn2:sequenceFlow id="Flow_StateNew_To_TransIP" sourceRef="State_NEW" targetRef="StateNew_CatchInProgress"/>
    <bpmn2:sequenceFlow id="Flow_StateNew_To_TransClosed" sourceRef="State_NEW" targetRef="StateNew_CatchClosed"/>
    <bpmn2:sequenceFlow id="Flow_NewTransIP_To_LogIP" sourceRef="StateNew_CatchInProgress" targetRef="ScriptTask_LogToInProgress"/>
    <bpmn2:sequenceFlow id="Flow_NewTransClosed_To_End" sourceRef="StateNew_CatchClosed" targetRef="ScriptTask_LogClosed"/>

    <!-- STATE BRANCH: IN_PROGRESS -->
    <bpmn2:sequenceFlow id="Flow_LogIP_To_StateIP" sourceRef="ScriptTask_LogToInProgress" targetRef="State_IN_PROGRESS"/>
    <bpmn2:sequenceFlow id="Flow_StateIP_To_TransNew" sourceRef="State_IN_PROGRESS" targetRef="StateIP_CatchNew"/>
    <bpmn2:sequenceFlow id="Flow_StateIP_To_TransWaiting" sourceRef="State_IN_PROGRESS" targetRef="StateIP_CatchWaiting"/>
    <bpmn2:sequenceFlow id="Flow_StateIP_To_TransResolved" sourceRef="State_IN_PROGRESS" targetRef="StateIP_CatchResolved"/>
    <bpmn2:sequenceFlow id="Flow_StateIP_To_TransClosed" sourceRef="State_IN_PROGRESS" targetRef="StateIP_CatchClosed"/>
    <bpmn2:sequenceFlow id="Flow_IPTransNew_To_LogNew" sourceRef="StateIP_CatchNew" targetRef="ScriptTask_LogToNew"/>
    <bpmn2:sequenceFlow id="Flow_IPTransWaiting_To_LogWaiting" sourceRef="StateIP_CatchWaiting" targetRef="ScriptTask_LogToWaiting"/>
    <bpmn2:sequenceFlow id="Flow_IPTransResolved_To_LogResolved" sourceRef="StateIP_CatchResolved" targetRef="ScriptTask_LogToResolved"/>
    <bpmn2:sequenceFlow id="Flow_IPTransClosed_To_End" sourceRef="StateIP_CatchClosed" targetRef="ScriptTask_LogClosed"/>

    <!-- STATE BRANCH: log → next state -->
    <bpmn2:sequenceFlow id="Flow_LogToNew_To_StateNew" sourceRef="ScriptTask_LogToNew" targetRef="State_NEW"/>
    <bpmn2:sequenceFlow id="Flow_LogToWaiting_To_StateWaiting" sourceRef="ScriptTask_LogToWaiting" targetRef="State_WAITING"/>
    <bpmn2:sequenceFlow id="Flow_LogToResolved_To_StateResolved" sourceRef="ScriptTask_LogToResolved" targetRef="State_RESOLVED"/>

    <!-- STATE BRANCH: WAITING -->
    <bpmn2:sequenceFlow id="Flow_StateWaiting_To_TransIP" sourceRef="State_WAITING" targetRef="StateWaiting_CatchInProgress"/>
    <bpmn2:sequenceFlow id="Flow_StateWaiting_To_TransClosed" sourceRef="State_WAITING" targetRef="StateWaiting_CatchClosed"/>
    <bpmn2:sequenceFlow id="Flow_WaitingTransIP_To_LogIP" sourceRef="StateWaiting_CatchInProgress" targetRef="ScriptTask_LogToInProgress"/>
    <bpmn2:sequenceFlow id="Flow_WaitingTransClosed_To_End" sourceRef="StateWaiting_CatchClosed" targetRef="ScriptTask_LogClosed"/>

    <!-- STATE BRANCH: RESOLVED -->
    <bpmn2:sequenceFlow id="Flow_StateResolved_To_TransIP" sourceRef="State_RESOLVED" targetRef="StateResolved_CatchInProgress"/>
    <bpmn2:sequenceFlow id="Flow_StateResolved_To_TransClosed" sourceRef="State_RESOLVED" targetRef="StateResolved_CatchClosed"/>
    <bpmn2:sequenceFlow id="Flow_ResolvedTransIP_To_LogIP" sourceRef="StateResolved_CatchInProgress" targetRef="ScriptTask_LogToInProgress"/>
    <bpmn2:sequenceFlow id="Flow_ResolvedTransClosed_To_End" sourceRef="StateResolved_CatchClosed" targetRef="ScriptTask_LogClosed"/>

    <!-- STATE BRANCH: CLOSED (terminate end) -->
    <bpmn2:sequenceFlow id="Flow_LogClosed_To_End" sourceRef="ScriptTask_LogClosed" targetRef="EndEvent_StateClosed"/>

    <!-- SLA BRANCH (existing flow) -->
    <bpmn2:sequenceFlow id="Flow_XorMerge_To_SlaGateway" sourceRef="Gateway_XorMerge" targetRef="Gateway_Sla"/>
    <bpmn2:sequenceFlow id="Flow_SlaGw_To_Timer" sourceRef="Gateway_Sla" targetRef="Timer_SlaDeadline"/>
    <bpmn2:sequenceFlow id="Flow_SlaGw_To_PauseSignal" sourceRef="Gateway_Sla" targetRef="Signal_PauseSla_Catch"/>
    <bpmn2:sequenceFlow id="Flow_SlaGw_To_CloseSignal1" sourceRef="Gateway_Sla" targetRef="Signal_Close_InSla"/>
    <bpmn2:sequenceFlow id="Flow_Timer_To_BreachLog" sourceRef="Timer_SlaDeadline" targetRef="ScriptTask_BreachLog"/>
    <bpmn2:sequenceFlow id="Flow_BreachLog_To_RestCall" sourceRef="ScriptTask_BreachLog" targetRef="RestTask_SlaCallback"/>
    <bpmn2:sequenceFlow id="Flow_RestCall_To_PostBreachClose" sourceRef="RestTask_SlaCallback" targetRef="Signal_Close_PostBreach"/>
    <bpmn2:sequenceFlow id="Flow_ClosePostBreach_To_PostBreachCloseLog" sourceRef="Signal_Close_PostBreach" targetRef="ScriptTask_PostBreachClose"/>
    <bpmn2:sequenceFlow id="Flow_PostBreachClose_To_End3" sourceRef="ScriptTask_PostBreachClose" targetRef="EndEvent_ClosedPostBreach"/>
    <bpmn2:sequenceFlow id="Flow_PauseSignal_To_PauseLog" sourceRef="Signal_PauseSla_Catch" targetRef="ScriptTask_PauseLog"/>
    <bpmn2:sequenceFlow id="Flow_PauseLog_To_PausedGw" sourceRef="ScriptTask_PauseLog" targetRef="Gateway_Paused"/>
    <bpmn2:sequenceFlow id="Flow_PausedGw_To_ResumeSignal" sourceRef="Gateway_Paused" targetRef="Signal_ResumeSla_Catch"/>
    <bpmn2:sequenceFlow id="Flow_PausedGw_To_CloseSignal2" sourceRef="Gateway_Paused" targetRef="Signal_Close_InPaused"/>
    <bpmn2:sequenceFlow id="Flow_ResumeSignal_To_ResumeLog" sourceRef="Signal_ResumeSla_Catch" targetRef="ScriptTask_ResumeLog"/>
    <bpmn2:sequenceFlow id="Flow_ResumeScript_To_XorMerge" sourceRef="ScriptTask_ResumeLog" targetRef="Gateway_XorMerge"/>
    <bpmn2:sequenceFlow id="Flow_CloseInSla_To_CloseLog" sourceRef="Signal_Close_InSla" targetRef="ScriptTask_CloseInSlaLog"/>
    <bpmn2:sequenceFlow id="Flow_CloseInSlaLog_To_End1" sourceRef="ScriptTask_CloseInSlaLog" targetRef="EndEvent_ClosedFromSla"/>
    <bpmn2:sequenceFlow id="Flow_CloseInPaused_To_CloseLog" sourceRef="Signal_Close_InPaused" targetRef="ScriptTask_CloseInPausedLog"/>
    <bpmn2:sequenceFlow id="Flow_CloseInPausedLog_To_End2" sourceRef="ScriptTask_CloseInPausedLog" targetRef="EndEvent_ClosedFromPaused"/>

  </bpmn2:process>

  <!--
      BPMN diyagram yerleşim bilgileri (DI).
      İki dikey şerit: üstte state branch (state machine), altta SLA branch (mevcut).
      Konumlar mekanik olarak doğru ama estetik değil; modeli BPMN editörde
      açıp yeniden hizalamak isterseniz mantığı koruyarak shape koordinatlarını
      değiştirebilirsiniz.
  -->
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="com.ticketsystem.workflow.ticket-lifecycle">
      <bpmndi:BPMNShape id="Shape_Start" bpmnElement="StartEvent_1">
        <dc:Bounds x="50" y="380" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Init" bpmnElement="ScriptTask_Init">
        <dc:Bounds x="140" y="358" width="140" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_ParallelSplit" bpmnElement="Gateway_ParallelSplit">
        <dc:Bounds x="320" y="375" width="50" height="50"/>
      </bpmndi:BPMNShape>

      <!-- STATE BRANCH (üst şerit) -->
      <bpmndi:BPMNShape id="Shape_StateNew" bpmnElement="State_NEW">
        <dc:Bounds x="420" y="100" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_StateNew_IP" bpmnElement="StateNew_CatchInProgress">
        <dc:Bounds x="520" y="60" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_StateNew_Closed" bpmnElement="StateNew_CatchClosed">
        <dc:Bounds x="520" y="160" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_LogIP" bpmnElement="ScriptTask_LogToInProgress">
        <dc:Bounds x="600" y="40" width="140" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_StateIP" bpmnElement="State_IN_PROGRESS">
        <dc:Bounds x="780" y="55" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_StateIP_New" bpmnElement="StateIP_CatchNew">
        <dc:Bounds x="880" y="20" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_StateIP_Waiting" bpmnElement="StateIP_CatchWaiting">
        <dc:Bounds x="880" y="80" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_StateIP_Resolved" bpmnElement="StateIP_CatchResolved">
        <dc:Bounds x="880" y="140" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_StateIP_Closed" bpmnElement="StateIP_CatchClosed">
        <dc:Bounds x="880" y="200" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_LogToNew" bpmnElement="ScriptTask_LogToNew">
        <dc:Bounds x="960" y="0" width="140" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_LogToWaiting" bpmnElement="ScriptTask_LogToWaiting">
        <dc:Bounds x="960" y="80" width="140" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_LogToResolved" bpmnElement="ScriptTask_LogToResolved">
        <dc:Bounds x="960" y="160" width="140" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_StateWaiting" bpmnElement="State_WAITING">
        <dc:Bounds x="1140" y="95" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_StateWaiting_IP" bpmnElement="StateWaiting_CatchInProgress">
        <dc:Bounds x="1240" y="60" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_StateWaiting_Closed" bpmnElement="StateWaiting_CatchClosed">
        <dc:Bounds x="1240" y="160" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_StateResolved" bpmnElement="State_RESOLVED">
        <dc:Bounds x="1140" y="175" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_StateResolved_IP" bpmnElement="StateResolved_CatchInProgress">
        <dc:Bounds x="1240" y="240" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_StateResolved_Closed" bpmnElement="StateResolved_CatchClosed">
        <dc:Bounds x="1240" y="280" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_LogClosed" bpmnElement="ScriptTask_LogClosed">
        <dc:Bounds x="1320" y="120" width="140" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_EndStateClosed" bpmnElement="EndEvent_StateClosed">
        <dc:Bounds x="1500" y="142" width="36" height="36"/>
      </bpmndi:BPMNShape>

      <!-- SLA BRANCH (alt şerit) -->
      <bpmndi:BPMNShape id="Shape_XorMerge" bpmnElement="Gateway_XorMerge">
        <dc:Bounds x="420" y="500" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_SlaGw" bpmnElement="Gateway_Sla">
        <dc:Bounds x="500" y="500" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Timer" bpmnElement="Timer_SlaDeadline">
        <dc:Bounds x="600" y="430" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_PauseSignal" bpmnElement="Signal_PauseSla_Catch">
        <dc:Bounds x="600" y="510" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_CloseInSla" bpmnElement="Signal_Close_InSla">
        <dc:Bounds x="600" y="590" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_BreachLog" bpmnElement="ScriptTask_BreachLog">
        <dc:Bounds x="680" y="410" width="140" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_RestCall" bpmnElement="RestTask_SlaCallback">
        <dc:Bounds x="860" y="410" width="140" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_ClosePostBreach" bpmnElement="Signal_Close_PostBreach">
        <dc:Bounds x="1040" y="432" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_PostBreachCloseLog" bpmnElement="ScriptTask_PostBreachClose">
        <dc:Bounds x="1120" y="410" width="140" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_EndPostBreach" bpmnElement="EndEvent_ClosedPostBreach">
        <dc:Bounds x="1300" y="432" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_PauseLog" bpmnElement="ScriptTask_PauseLog">
        <dc:Bounds x="680" y="490" width="140" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_PausedGw" bpmnElement="Gateway_Paused">
        <dc:Bounds x="860" y="505" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_ResumeSignal" bpmnElement="Signal_ResumeSla_Catch">
        <dc:Bounds x="950" y="475" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_CloseInPaused" bpmnElement="Signal_Close_InPaused">
        <dc:Bounds x="950" y="555" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_ResumeLog" bpmnElement="ScriptTask_ResumeLog">
        <dc:Bounds x="1020" y="455" width="140" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_CloseInSlaLog" bpmnElement="ScriptTask_CloseInSlaLog">
        <dc:Bounds x="680" y="590" width="140" height="60"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_CloseInPausedLog" bpmnElement="ScriptTask_CloseInPausedLog">
        <dc:Bounds x="1020" y="555" width="140" height="60"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_EndFromSla" bpmnElement="EndEvent_ClosedFromSla">
        <dc:Bounds x="860" y="600" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_EndFromPaused" bpmnElement="EndEvent_ClosedFromPaused">
        <dc:Bounds x="1200" y="567" width="36" height="36"/>
      </bpmndi:BPMNShape>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>

</bpmn2:definitions>
