# =====================================================================
# data-generator — local configuration
# =====================================================================
# Copy this file to `data-generator/.env` and fill in your secrets.
# The generator resolves each value in this order:
#   1) OS environment variable (e.g. exported in the shell)
#   2) This file (data-generator/.env)
#   3) Hardcoded fallback in GeneratorConfig.java
# Lines starting with `#` are ignored.
#
# Run from repo root: `make gen`
# Run from this dir:  `java -jar target/data-generator-1.0.0.jar`
# =====================================================================

# ---------------------------------------------------------------------
# Credentials (the values you most likely need to change)
# ---------------------------------------------------------------------

# Password for the seed agent_admin user (LDAP_AGENT_ADMIN_PASSWORD in the
# root .env). The generator logs in as this user and drives every API call.
ADMIN_AGENT_PASSWORD=321654

# Keycloak master-realm admin password (KEYCLOAK_ADMIN_PASSWORD in the root
# .env). Used only to clear `required actions` on newly created users.
MASTER_ADMIN_PASSWORD=321654

# PostgreSQL password (SPRING_DATASOURCE_PASSWORD in the root .env). Needed
# for the direct JDBC connection that backfills ticket timestamps.
DB_PASSWORD=321654

# ---------------------------------------------------------------------
# Usernames — change only if you renamed the seed accounts
# ---------------------------------------------------------------------
ADMIN_AGENT_USERNAME=aatest
MASTER_ADMIN_USERNAME=admin

# ---------------------------------------------------------------------
# Endpoints — change if the stack runs at a different host/port
# ---------------------------------------------------------------------
# BASE_URL=http://localhost
# KEYCLOAK_URL=http://localhost/auth
# KEYCLOAK_REALM=TicketSystemRealm
# KEYCLOAK_CLIENT=ticket-frontend
# MASTER_ADMIN_CLIENT=admin-cli

# ---------------------------------------------------------------------
# PostgreSQL (only override if you point the generator at a non-default DB)
# ---------------------------------------------------------------------
# DB_URL=jdbc:postgresql://localhost:5432/ticketdb
# DB_USER=ticketadmin

# ---------------------------------------------------------------------
# Operational knobs (rarely needed; defaults are sensible)
# ---------------------------------------------------------------------
# DELAY_MS=600
# COMMENT_DELAY_MS=5500
# RATE_LIMIT_BACKOFF_MS=6000
# RATE_LIMIT_RETRY_COUNT=3
# TOKEN_REFRESH_THRESHOLD_SEC=30
# DATE_SPREAD_DAYS=7
