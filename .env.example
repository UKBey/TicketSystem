# =====================================================================
# Bu dosya DEV için ÇALIŞAN varsayılanlarla gelir:
#   cp .env.example .env   →  make up  (başka düzenleme gerekmez)
# Ortak dev parolası 321654'tür. PROD'da tüm parola/secret'ları değiştirin
# (docker-compose.prod.yaml başlığındaki listeye bakın).
# Tek istisna: GROQ_API_KEY — yalnızca AI özet üretimi için gerekir (aşağıya bakın).
# =====================================================================

# ===============================
# PostgreSQL (Main App DB)
# ===============================
POSTGRES_USER=ticketadmin
POSTGRES_PASSWORD=321654
POSTGRES_DB=ticketdb

# ===============================
# Docker Image Registry (CD)
# ===============================
# Lokal geliştirmede boş bırakın (compose `local/` öneki ve build: direktifini kullanır); CD doldurur.
DOCKERHUB_USERNAME=
IMAGE_TAG=latest

# ===============================
# Keycloak
# ===============================
KEYCLOAK_DB_USERNAME=ticketadmin
KEYCLOAK_DB_PASSWORD=321654
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=321654
# Keycloak'ın dış erişim adresi (tek doğruluk kaynağı). KC_HOSTNAME_URL ve JWT issuer
# bundan türetilir. Local: http://localhost/auth · Prod: https://<domain>/auth
KEYCLOAK_FRONTEND_URL=http://localhost/auth
KEYCLOAK_REALM=TicketSystemRealm

# ===============================
# LDAP (seed kullanıcı parolaları — her demo kullanıcı için bir tane)
# ===============================
LDAP_ORGANISATION=Ticket System
LDAP_DOMAIN=ticketsystem.com
LDAP_ADMIN_PASSWORD=321654
LDAP_CUSTOMER_PASSWORD=321654
LDAP_AGENT_PASSWORD=321654
LDAP_LEAD_PASSWORD=321654
LDAP_MANAGER_PASSWORD=321654
LDAP_ADMIN_USER_PASSWORD=321654
LDAP_ADMINMANAGER_PASSWORD=321654
LDAP_LEADMANAGER_PASSWORD=321654
LDAP_SUPERADMIN_PASSWORD=321654

# ===============================
# Backend (Spring Boot)
# ===============================
SPRING_DATASOURCE_URL=jdbc:postgresql://it-service-db:5432/ticketdb
SPRING_DATASOURCE_USERNAME=ticketadmin
SPRING_DATASOURCE_PASSWORD=321654

# ===============================
# jBPM / KIE
# ===============================
JBPM_DB_USER=jbpmadmin
JBPM_DB_PASSWORD=321654
JBPM_DB_NAME=jbpmdb

JBPM_KIE_SERVER_URL=http://kie-server:8080/kie-server/services/rest/server
JBPM_KIE_SERVER_USERNAME=kieserver
# DİKKAT: kie-server imajının gömülü varsayılan kullanıcısı kieserver/kieserver1! —
# bu ikisini değiştirmeyin (container parolayı env'den almaz, backend'in girişi bozulur).
JBPM_KIE_SERVER_PASSWORD=kieserver1!
JBPM_KIE_SERVER_CONTAINER_ID=ticket-workflow
JBPM_KIE_SERVER_PROCESS_ID=com.ticketsystem.workflow.ticket-lifecycle
JBPM_KIE_SERVER_TIMEOUT=30000
JBPM_KIE_SERVER_CALLBACK_TOKEN=dev-internal-callback-token-321654
JBPM_KIE_SERVER_CALLBACK_BASE_URL=http://it-service-backend:8081/api/v1/internal/workflow/callback

# ===============================
# Mail (Mailpit - Development)
# ===============================
# Dev'de compose overlay backend'i mailpit:1025'e bağlar; buradaki değerler hibrit
# lokal çalıştırma (make infra + make dev-backend) içindir. Gelen mailler: http://localhost:8025
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_FROM=noreply@ticketsystem.local

# ===============================
# Yorumlar (Comments)
# ===============================
# Aynı kullanıcının iki yorumu arasındaki min. bekleme (sn). Max uzunluk DB CHECK (V23)
# ile 500'de sabit; COMMENT_MAX_LENGTH yalnızca aşağı çekmek için kullanılır.
COMMENT_COOLDOWN_SECONDS=3
#COMMENT_MAX_LENGTH=500

# ===============================
# Keycloak Admin Client (Backend Service Account)
# ===============================
# Bu deger realm import'ta ticket-client'in secret'i olarak Keycloak'a gomulur
# (realm-export.json icindeki ${KEYCLOAK_ADMIN_CLIENT_SECRET} placeholder'i);
# backend ayni degeri kullanir. Dev varsayilani calisir — PROD'da guclu, rastgele
# bir degerle degistirin (degisiklik realm'i yeniden import etmeyi gerektirir).
KEYCLOAK_ADMIN_CLIENT_ID=ticket-client
KEYCLOAK_ADMIN_CLIENT_SECRET=dev-ticket-client-secret-321654

# ===============================
# Rate Limit (Global API)
# ===============================
RATE_LIMIT_GLOBAL_MAX_REQUESTS=100
RATE_LIMIT_GLOBAL_DURATION_SECONDS=60
RATE_LIMIT_GLOBAL_ENABLED=true

# ===============================
# Şifre Sıfırlama (Forgot Password)
# ===============================
# Token ömrü (dk) ve mail içindeki reset linkinin frontend taban adresi.
PASSWORD_RESET_TOKEN_TTL_MINUTES=60
PASSWORD_RESET_FRONTEND_BASE_URL=http://localhost
# Rate limit (IP başına). ENABLED=false ile tamamen kapatılır. Varsayılan: 5 istek / 3600 sn.
PASSWORD_RESET_RATE_LIMIT_ENABLED=true
PASSWORD_RESET_RATE_LIMIT_MAX=5
PASSWORD_RESET_RATE_LIMIT_WINDOW_SECONDS=3600

# ===============================
# Redis (rate-limit + gelecekteki cache/queue)
# ===============================
# Docker stack içinde host=redis; local dev (make infra + make dev-backend) için localhost.
SPRING_DATA_REDIS_HOST=redis
SPRING_DATA_REDIS_PORT=6379
# Boş bırakın: dev'deki redis container'ı şifresiz çalışır (compose'ta --requirepass yok).
# Production'da Redis'i şifreli kurup burayı set edin.
SPRING_DATA_REDIS_PASSWORD=

# ===============================
# LLM Service Rate Limit (per-IP)
# ===============================
LLM_RATE_LIMIT_ENABLED=true
LLM_RATE_LIMIT_MAX_REQUESTS=1
LLM_RATE_LIMIT_DURATION_SECONDS=10
# Sadece pahalı "generate" endpoint'i throttle edilir (latest/list okumaları edilmez).
LLM_RATE_LIMIT_PATH_PATTERNS=/api/v1/ai/summaries/tickets/*/generate

# ===============================
# LLM Service (Groq)
# ===============================
# OPSİYONEL: Stack bu anahtar olmadan da tamamen çalışır; yalnızca bilet AI özeti
# üretimi Groq'a gider. Ücretsiz anahtar: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant
GROQ_MAX_TOKENS=1024
GROQ_TIMEOUT_SECONDS=30
# Backend internal endpoint'leri için shared secret — JBPM_KIE_SERVER_CALLBACK_TOKEN ile aynı olmalı.
TICKET_SERVICE_INTERNAL_TOKEN=dev-internal-callback-token-321654

# ===============================
# SLA Politikaları (saat) — opsiyonel; tanımlanmazsa application.yml varsayılanları kullanılır.
# Boş bırakmayın (örn. SLA_HIGH_RESOLUTION_HOURS= hata verir): ya sayı yazın ya da satırı silin.
# ===============================
#SLA_LOW_RESOLUTION_HOURS=72
#SLA_LOW_WARNING_HOURS=2
#SLA_MEDIUM_RESOLUTION_HOURS=24
#SLA_MEDIUM_WARNING_HOURS=2
#SLA_HIGH_RESOLUTION_HOURS=4
#SLA_HIGH_WARNING_HOURS=1
#SLA_CRITICAL_RESOLUTION_HOURS=1
#SLA_CRITICAL_WARNING_HOURS=0

# ===============================
# Dashboard "uzun süredir bekleyen" uyarıları (saat) — opsiyonel.
# ===============================
#ALERTS_WAITING_FOR_CUSTOMER_MAX_HOURS=48
#ALERTS_RESOLVED_MAX_HOURS=72

# ===============================
# SonarQube
# ===============================
SONAR_DB_USER=sonar
SONAR_DB_PASSWORD=321654
SONAR_DB_NAME=sonarqube
# Token: http://localhost:9000 arayüzünden oluştur. Kullanım: SONAR_TOKEN=<token> make sonar
SONAR_TOKEN=
