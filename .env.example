# ===============================
# PostgreSQL (Main App DB)
# ===============================
POSTGRES_USER=ticketadmin
POSTGRES_PASSWORD=your_db_password_here
POSTGRES_DB=ticketdb

# ===============================
# Docker Image Registry (CD)
# ===============================
# Docker Hub kullanıcı adı — CD pipeline tarafından otomatik set edilir.
# Lokal geliştirmede boş bırakılabilir (build: direktifi kullanılır).
DOCKERHUB_USERNAME=your_dockerhub_username
# IMAGE_TAG: latest (varsayılan) veya git SHA (CD tarafından set edilir)
IMAGE_TAG=latest

# ===============================
# Keycloak
# ===============================
KEYCLOAK_DB_USERNAME=ticketadmin
KEYCLOAK_DB_PASSWORD=your_keycloak_db_password_here
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=your_keycloak_admin_password_here
# Nginx reverse proxy uzerinden erisim. Local: http://localhost/auth
# Production'da sunucu URL'ini yaz (ör: https://1.2.3.4/auth veya https://domain.com/auth)
KEYCLOAK_FRONTEND_URL=http://localhost/auth

# ===============================
# LDAP
# ===============================
LDAP_ORGANISATION=Ticket System
LDAP_DOMAIN=ticketsystem.com
LDAP_ADMIN_PASSWORD=your_ldap_admin_password_here
LDAP_CUSTOMER_PASSWORD=your_customer_password_here
LDAP_AGENT_PASSWORD=your_agent_password_here
LDAP_AGENT_ADMIN_PASSWORD=your_agent_admin_password_here
LDAP_MANAGER_PASSWORD=your_manager_password_here

# ===============================
# Backend (Spring Boot)
# ===============================
SPRING_DATASOURCE_URL=jdbc:postgresql://it-service-db:5432/ticketdb
SPRING_DATASOURCE_USERNAME=ticketadmin
SPRING_DATASOURCE_PASSWORD=your_spring_db_password_here
# Local: http://localhost/auth/realms/TicketSystemRealm
# Production: https://<SUNUCU_IP>/auth/realms/TicketSystemRealm
SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_ISSUER_URI=http://localhost/auth/realms/TicketSystemRealm
SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_JWK_SET_URI=http://keycloak-iam:8080/auth/realms/TicketSystemRealm/protocol/openid-connect/certs

# ===============================
# jBPM / KIE
# ===============================
JBPM_DB_USER=jbpmadmin
JBPM_DB_PASSWORD=your_jbpm_db_password_here
JBPM_DB_NAME=jbpmdb

JBPM_KIE_SERVER_URL=http://kie-server:8080/kie-server/services/rest/server
JBPM_KIE_SERVER_USERNAME=kieserver
JBPM_KIE_SERVER_PASSWORD=your_kie_server_password_here
JBPM_KIE_SERVER_CONTAINER_ID=ticket-workflow
JBPM_KIE_SERVER_PROCESS_ID=com.ticketsystem.workflow.ticket-lifecycle
JBPM_KIE_SERVER_TIMEOUT=30000
JBPM_KIE_SERVER_CALLBACK_TOKEN=your_callback_secret_token_here
JBPM_KIE_SERVER_CALLBACK_BASE_URL=http://it-service-backend:8081/api/internal/workflow/callback

# ===============================
# Mail (Mailpit - Development)
# ===============================
# http://localhost:8025 adresinden gelen mailleri izle
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_FROM=noreply@ticketsystem.local

# ===============================
# Keycloak Admin Client (Backend Service Account)
# ===============================
# Backend'in Keycloak Admin API'ye erişmesi için kullanılır.
# ticket-client üzerinde serviceAccountsEnabled: true yapıldıktan sonra
# Keycloak Admin UI > Clients > ticket-client > Credentials sekmesinden secret alınır.
KEYCLOAK_ADMIN_SERVER_URL=http://keycloak-iam:8080/auth
KEYCLOAK_ADMIN_REALM=TicketSystemRealm
KEYCLOAK_ADMIN_CLIENT_ID=ticket-client
KEYCLOAK_ADMIN_CLIENT_SECRET=<keycloak-admin-ui-den-alinacak-secret>

# ===============================
# Rate Limit Configuration
# ===============================
# Global API rate limiting - maksimum istek sayısı
RATE_LIMIT_GLOBAL_MAX_REQUESTS=100
# Global API rate limiting - zaman penceresi (saniye)
RATE_LIMIT_GLOBAL_DURATION_SECONDS=60
# Global API rate limiting - aktif/pasif durumu
RATE_LIMIT_GLOBAL_ENABLED=true

# ===============================
# Redis (rate-limit + gelecekteki cache/queue)
# ===============================
# Docker stack icinden bagli ise host=redis. Local dev (make infra + make dev-backend) icin localhost.
SPRING_DATA_REDIS_HOST=redis
SPRING_DATA_REDIS_PORT=6379
# Bos birakilirsa kimliksiz baglanti. Production'da mutlaka set edilmeli.
SPRING_DATA_REDIS_PASSWORD=

# ===============================
# LLM Service (Groq)
# ===============================
# Groq API anahtarı: https://console.groq.com/keys adresinden alınır
GROQ_API_KEY=your_groq_api_key_here
# Kullanılacak model (varsayılan: llama3-8b-8192)
GROQ_MODEL=llama3-8b-8192
# Maksimum üretilecek token sayısı
GROQ_MAX_TOKENS=1024
# Groq API zaman aşımı (saniye)
GROQ_TIMEOUT_SECONDS=30
# it-service-backend internal endpoint'leri için shared secret
# JBPM_KIE_SERVER_CALLBACK_TOKEN ile aynı değer olmalıdır
TICKET_SERVICE_INTERNAL_TOKEN=your_callback_secret_token_here

# ===============================
# SLA Politikaları (saat cinsinden)
# Tanımlanmazsa application.yml'deki varsayılanlar kullanılır.
# ÖNEMLİ: Boş bırakmak (SLA_HIGH_RESOLUTION_HOURS=) hata verir;
#          ya tamamen sil ya da geçerli bir sayı yaz.
# ===============================
#SLA_LOW_RESOLUTION_HOURS=72
#SLA_LOW_WARNING_HOURS=2
#SLA_MEDIUM_RESOLUTION_HOURS=24
#SLA_MEDIUM_WARNING_HOURS=2
#SLA_HIGH_RESOLUTION_HOURS=4
#SLA_HIGH_WARNING_HOURS=1
#SLA_CRITICAL_RESOLUTION_HOURS=1
#SLA_CRITICAL_WARNING_HOURS=0

# ===============================
# SonarQube
# ===============================
SONAR_DB_USER=sonar
SONAR_DB_PASSWORD=your_sonar_db_password_here
SONAR_DB_NAME=sonarqube
# Analiz icin token: SonarQube arayuzunden (http://localhost:9000) olustur
# Kullanim: SONAR_TOKEN=<token> make sonar
SONAR_TOKEN=
