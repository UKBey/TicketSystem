# ===============================
# PostgreSQL (Main App DB)
# ===============================
POSTGRES_USER=ticketadmin
POSTGRES_PASSWORD=your_db_password_here
POSTGRES_DB=ticketdb

# ===============================
# Keycloak
# ===============================
KEYCLOAK_DB_USERNAME=ticketadmin
KEYCLOAK_DB_PASSWORD=your_keycloak_db_password_here
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=your_keycloak_admin_password_here
# Local'de boş bırak. Production'da sunucu URL'ini yaz (ör: https://1.2.3.4)
KEYCLOAK_FRONTEND_URL=

# ===============================
# LDAP
# ===============================
LDAP_ORGANISATION=Ticket System
LDAP_DOMAIN=ticketsystem.com
LDAP_ADMIN_PASSWORD=your_ldap_admin_password_here
LDAP_CUSTOMER_PASSWORD=your_customer_password_here
LDAP_AGENT_PASSWORD=your_agent_password_here
LDAP_AGENT_ADMIN_PASSWORD=your_agent_admin_password_here
LDAP_MANAGER_PASSWORD=your_manager_password_here

# ===============================
# Backend (Spring Boot)
# ===============================
SPRING_DATASOURCE_URL=jdbc:postgresql://it-service-db:5432/ticketdb
SPRING_DATASOURCE_USERNAME=ticketadmin
SPRING_DATASOURCE_PASSWORD=your_spring_db_password_here
# Local: http://localhost:8080/realms/TicketSystemRealm
# Production: https://<SUNUCU_IP>/realms/TicketSystemRealm
SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_ISSUER_URI=http://localhost:8080/realms/TicketSystemRealm
SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_JWK_SET_URI=http://keycloak-iam:8080/realms/TicketSystemRealm/protocol/openid-connect/certs

# ===============================
# jBPM / KIE
# ===============================
JBPM_DB_USER=jbpmadmin
JBPM_DB_PASSWORD=your_jbpm_db_password_here
JBPM_DB_NAME=jbpmdb

JBPM_KIE_SERVER_URL=http://kie-server:8080/kie-server/services/rest/server
JBPM_KIE_SERVER_USERNAME=kieserver
JBPM_KIE_SERVER_PASSWORD=your_kie_server_password_here
JBPM_KIE_SERVER_CONTAINER_ID=ticket-workflow
JBPM_KIE_SERVER_PROCESS_ID=com.ticketsystem.workflow.ticket-lifecycle
JBPM_KIE_SERVER_TIMEOUT=30000
JBPM_KIE_SERVER_CALLBACK_TOKEN=your_callback_secret_token_here
JBPM_KIE_SERVER_CALLBACK_BASE_URL=http://it-service-backend:8081/api/internal/workflow/callback
