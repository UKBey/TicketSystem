# jboss-cli batch (offline) — registers the PostgreSQL JDBC driver and the
# jbpmDS datasource into standalone-full-kie-server.xml at image build time.
#
# Connection coordinates are stored as WildFly ${env.*} expressions and resolved
# at container start from the kie-server service environment (docker-compose),
# so the same image works across environments without rebuilding. The KIE Server
# is pointed at this datasource via -Dorg.kie.server.persistence.ds in JAVA_OPTS;
# jBPM's persistence unit (hibernate.hbm2ddl.auto=update) creates the schema on
# first boot.
embed-server --server-config=standalone-full-kie-server.xml --std-out=echo

batch

/subsystem=datasources/jdbc-driver=postgresql:add( \
    driver-name=postgresql, \
    driver-module-name=org.postgresql, \
    driver-class-name=org.postgresql.Driver, \
    driver-xa-datasource-class-name=org.postgresql.xa.PGXADataSource)

/subsystem=datasources/data-source=jbpmDS:add( \
    jndi-name=java:jboss/datasources/jbpmDS, \
    enabled=true, \
    use-java-context=true, \
    driver-name=postgresql, \
    connection-url="jdbc:postgresql://${env.JBPM_DB_HOST:jbpm-db}:${env.JBPM_DB_PORT:5432}/${env.JBPM_DB_NAME:jbpmdb}", \
    user-name="${env.JBPM_DB_USER:jbpmadmin}", \
    password="${env.JBPM_DB_PASSWORD}", \
    jta=true, \
    min-pool-size=2, \
    max-pool-size=20, \
    background-validation=true, \
    background-validation-millis=60000, \
    valid-connection-checker-class-name=org.jboss.jca.adapters.jdbc.extensions.postgres.PostgreSQLValidConnectionChecker, \
    exception-sorter-class-name=org.jboss.jca.adapters.jdbc.extensions.postgres.PostgreSQLExceptionSorter)

run-batch

stop-embedded-server
