# Satir sonlarini platformlar arasi sabitle.
# Makefile ve POSIX shell scriptleri DAIMA LF olmali: CRLF, Linux'ta GNU Make'in
# recipe komutlarina '\r' sizdirir ve "command not found" / sozdizimi hatalari verir.
Makefile        text eol=lf
*.sh            text eol=lf
mvnw            text eol=lf

# LDAP seed sablonu container'da `sed` ile islenir; CRLF, userPassword gibi
# degerlere '\r' sizdirir ve LDAP/Keycloak login'ini bozar. DAIMA LF olmali.
*.ldif          text eol=lf
*.template      text eol=lf

# KIE Server image'ina gomulen jboss-cli script'i ve WildFly modul tanimi
# Linux container'da islenir; .cli backslash satir-devami CRLF ile bozulur.
# DAIMA LF olmali.
*.cli           text eol=lf
kie/modules/**  text eol=lf

# Windows'a ozgu script'ler CRLF kalmali.
*.bat           text eol=crlf
*.cmd           text eol=crlf
