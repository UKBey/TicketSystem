# syntax=docker/dockerfile:1.7
#
# Custom KIE Server image — ticket-workflow kjar'ini (repo'daki ticket-workflow-kjar/
# kaynagi) imajin Maven repository'sine gomer. Boylece taze `docker compose up` ilk
# seferden itibaren kjar'i hazir bulur; `kjar-deploy` job'u container'i register eder.
# (Volume'a bagimli degil -> ekip/temiz makine senaryosunda da calisir.)
#
# kie-maven-plugin 7.61.0.Final java.lang.Compiler (Java 9'da kaldirildi) referans
# ettigi icin kjar'i Java 8 ile derlemek gerek. Multi-stage build host Java'sindan bagimsiz.

# --- Build stage: kjar'i Java 8 maven ile derle ---
FROM maven:3.8.7-eclipse-temurin-8 AS kjar-build
WORKDIR /build
COPY ticket-workflow-kjar/pom.xml .
COPY ticket-workflow-kjar/src ./src
# BuildKit cache mount: .m2 cache layer'lar arasi korunur -> ikinci build hizli.
RUN --mount=type=cache,target=/root/.m2 mvn -q -B package -DskipTests

# --- Runtime stage: stok jbpm-server-full + kjar gomulu ---
FROM jboss/jbpm-server-full:7.61.0.Final
USER root

ARG KJAR_GROUP=com/ticketsystem
ARG KJAR_ARTIFACT=ticket-workflow-kjar
ARG KJAR_VERSION=1.0.5

RUN mkdir -p /opt/jboss/.m2/repository/${KJAR_GROUP}/${KJAR_ARTIFACT}/${KJAR_VERSION}

COPY --from=kjar-build /build/target/${KJAR_ARTIFACT}-${KJAR_VERSION}.jar \
     /opt/jboss/.m2/repository/${KJAR_GROUP}/${KJAR_ARTIFACT}/${KJAR_VERSION}/${KJAR_ARTIFACT}-${KJAR_VERSION}.jar

COPY ticket-workflow-kjar/pom.xml \
     /opt/jboss/.m2/repository/${KJAR_GROUP}/${KJAR_ARTIFACT}/${KJAR_VERSION}/${KJAR_ARTIFACT}-${KJAR_VERSION}.pom

# Named volume mount noktalarini (.niogit, standalone/data) imajda ONCEDEN jboss
# sahipligiyle olustur. Bos named volume bu dizinlerden initialize olur (jboss-owned)
# -> jboss (uid 1000) yazabilir, WildFly cokmesi onlenir, ayri bir chown-init servisine
# gerek KALMAZ. (.m2'de gomulu kjar zaten var.)
RUN mkdir -p /opt/jboss/.niogit /opt/jboss/wildfly/standalone/data \
 && chown -R jboss:jboss /opt/jboss/.m2 /opt/jboss/.niogit /opt/jboss/wildfly/standalone/data

USER jboss
